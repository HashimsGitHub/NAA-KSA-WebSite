{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "nust-alumni-api",
          "region": "me-central1",
          "pinTag": true
        }
      }
    ]
  }
}
