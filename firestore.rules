rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function approved() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function admin() {
      return approved()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list, create, update, delete: if admin();
    }
    match /events/{id} {
      allow read: if admin() || resource.data.status == 'published';
      allow create, update, delete: if admin();
    }
    match /knowledge/{id} {
      allow read: if admin() || (approved() && resource.data.status == 'published');
      allow create, update, delete: if admin();
    }
    match /alumni/{id} {
      allow read: if admin() || (approved()
        && resource.data.status == 'active'
        && resource.data.visibility == 'visible');
      allow create, update, delete: if admin();
    }
    match /alumniPrivate/{id} {
      allow read, write: if admin();
    }
  }
}
